{
  "name": "@jfs/netlify-kit",
  "version": "0.9.2",
  "description": "Shared, dependency-free Netlify Functions primitives (CORS + preflight, JSON/text/error responses, capped body reads, input validation, SSRF guards, retry-with-backoff fetch, per-IP rate limiting, a Blobs store opener + short-TTL cache, a createHandler boundary, and a hardened Anthropic (Claude) Messages-API client) extracted from the JFS family of buildless static sites.",
  "type": "module",
  "license": "MIT",
  "author": "jsvolos63",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsvolos63/netlify-kit.git"
  },
  "homepage": "https://github.com/jsvolos63/netlify-kit#readme",
  "keywords": [
    "netlify",
    "netlify-functions",
    "serverless",
    "cors",
    "ssrf",
    "rate-limit",
    "retry",
    "validation",
    "blobs",
    "cache"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "jfs-netlify-kit-vendor": "bin/vendor.mjs"
  },
  "files": [
    "index.js",
    "bin"
  ],
  "scripts": {
    "test": "node --test test.mjs test-vendor.mjs",
    "lint": "eslint .",
    "kit-pins:bump": "jfs-bump-kit-pins"
  },
  "dependencies": {
    "@jfs/vendor-cli": "github:jsvolos63/vendor-cli#276274b63dea9e88d36e70f7e77bc49e6e97e96b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
